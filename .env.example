# Cloudflare Tunnel token, used by the optional `tunnel` service in docker-compose.yml
# to expose this server to the internet via Cloudflare Zero Trust (for Dad's remote access).
#
# 1. Create a tunnel in the Cloudflare Zero Trust dashboard (Networks > Tunnels).
# 2. Copy the tunnel token shown during setup and paste it below.
# 3. Uncomment the `tunnel` service in docker-compose.yml before running `docker compose up`.
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access JWT verification for the backend (docs/architecture-specs.md section 6.1).
# Zero Trust dashboard > Access > Applications > (this app) > Overview:
#   CF_ACCESS_AUD          = "Application Audience (AUD) Tag"
#   CF_ACCESS_TEAM_DOMAIN  = your team domain, "<team>.cloudflareaccess.com" (Settings > Custom Pages)
# Leave both empty to skip the check (the backend then trusts Cf-Access-Authenticated-User-Email only).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional: extra accepted token issuers, comma-separated (e.g. the old team URL after renaming the team).
# CF_ACCESS_EXTRA_ISSUERS=

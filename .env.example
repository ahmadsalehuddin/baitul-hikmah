# Cloudflare Tunnel token, used by the optional `tunnel` service in docker-compose.yml
# to expose this server to the internet via Cloudflare Zero Trust (for Dad's remote access).
#
# 1. Create a tunnel in the Cloudflare Zero Trust dashboard (Networks > Tunnels).
# 2. Copy the tunnel token shown during setup and paste it below.
# 3. Uncomment the `tunnel` service in docker-compose.yml before running `docker compose up`.
CLOUDFLARE_TUNNEL_TOKEN=
